# Server configuration
NODE_ENV=production
PORT=3001

# Client URL for CORS (your domain)
CLIENT_URL=https://quizzy.yourdomain.com

# Public server URL (used for audio cache URLs in dev)
SERVER_URL=http://localhost:3001

# Admin page key (visit /admin?key=yourSecret)
ADMIN_KEY=changeme

# Movie clip cache settings
MOVIE_CLIP_SECONDS=20
MOVIE_CLIP_START=30
MOVIE_CLIP_START_PERCENT=0.3
MOVIE_CLIP_CONCURRENCY=2
