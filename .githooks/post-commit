#!/usr/bin/env bash
# Builds and pushes the Docker image after each commit on main.
# Enabled via: git config core.hooksPath .githooks

set -euo pipefail

BRANCH="main"

branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" != "$BRANCH" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
"$repo_root/.build-tools/build-and-push.sh"
